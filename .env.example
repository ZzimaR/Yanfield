# ─────────────────────────────────────────────────────────────────────────────
# 砚田 Yantian 环境变量示例
#
# 用法：复制为 .env 后按需取消注释
#       `cp .env.example .env`   或 Windows PowerShell：`Copy-Item .env.example .env`
#       Docker Compose 会通过 env_file 读取本文件。
#
# 说明：
#   1. .env 已在 .gitignore 中，不会被提交；不要把填了真实 Key 的 .env 发给别人。
#   2. API Key 最终以明文保存在本地 SQLite（data/yantian.db 的 providers 表），
#      仅适合个人机器 / 可信服务器使用。
#   3. 不填任何 Key 也能用：首次启动会创建「离线演示模式」Provider，模板输出、不联网。
#   4. 填了下面任意一个模型变量，首次启动会自动创建对应 Provider（预设定义在
#      lib/defaults.ts 的 PROVIDER_PRESETS）。已有同名 Provider 时会跳过，所以你在
#      设置页里手改过的 baseUrl / 模型不会被环境变量覆盖；当前默认模型如果还指向
#      「离线演示模式」，会自动切到第一个创建成功的真实服务。
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务 ──────────────────────────────────────────────────────────────────────
# 监听端口（pnpm start / Docker / standalone server.js 生效；pnpm dev 固定 3000）
PORT=3000

# 监听地址。本机使用保持 127.0.0.1；容器内或需要局域网访问时改为 0.0.0.0
HOSTNAME=127.0.0.1

# 数据库位置（相对路径按进程工作目录解析；默认 ./data/yantian.db）
# Docker 镜像内默认 /app/data/yantian.db
YANTIAN_DB_PATH=./data/yantian.db

# Windows 上没有符号链接权限时设为 0，关闭 next build 的 standalone 输出
# （详见 docs/deploy.md 的「方式一：Node 直接跑」与 README 部署一节）
# YANTIAN_STANDALONE=0

# 关闭 Next.js 构建/运行期遥测（默认建议开启）
NEXT_TELEMETRY_DISABLED=1

# 如果你的网络需要代理才能访问模型服务，设在运行砚田的进程上（不是浏览器）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── 模型服务（全部可选，填哪个建哪个）─────────────────────────────────────────
# 设置页也支持「选服务商 → 粘 Key → 测试连接」一步接入；这里只给 Docker / 自托管
# 一次性配置用。各家的 baseURL 与推荐模型见 docs/ai-providers.md。

# OpenAI（官方）
# OPENAI_API_KEY=sk-...

# DeepSeek（深度求索）
# DEEPSEEK_API_KEY=sk-...

# Moonshot / 月之暗面（Kimi）
# MOONSHOT_API_KEY=sk-...

# 阿里云百炼 / 通义千问（DashScope，OpenAI 兼容模式）
# DASHSCOPE_API_KEY=sk-...

# 智谱 GLM（bigmodel.cn）
# ZHIPU_API_KEY=...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini（AI Studio）
# GEMINI_API_KEY=...

# OpenRouter（聚合网关，一个 Key 访问多家模型）
# OPENROUTER_API_KEY=sk-or-...

# 硅基流动 SiliconFlow
# SILICONFLOW_API_KEY=sk-...

# 本地 Ollama：免 Key，改地址即可（默认即此值；容器里要改成宿主机地址）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── 任意 OpenAI 兼容服务（自建网关 / vLLM / LM Studio / one-api 中转）──────────
# 三个变量一起用；MODEL 留空时默认填 gpt-4o-mini，请改成服务商实际模型名。
# YANTIAN_OPENAI_COMPAT_BASE_URL=https://example.com/v1
# YANTIAN_OPENAI_COMPAT_API_KEY=...
# YANTIAN_OPENAI_COMPAT_MODEL=...
